<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TachePro.ViewModels"
             x:Class="TachePro.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,8" Spacing="10">
            <Label Text="Profil" Style="{StaticResource Title}" />

            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 36"
                    WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" Margin="0,16,0,0">
                <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="{Binding Name}" Style="{StaticResource Heading}" HorizontalOptions="Center" />
            <Label Text="{Binding Email}" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,0,0,12" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HeightRequest="40">
                    <Label Text="Notifications" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding NotificationsLabel}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Switch Grid.Column="2" IsToggled="{Binding NotificationsEnabled}" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HeightRequest="40">
                    <Label Text="Mode sombre" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding DarkModeLabel}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Switch Grid.Column="2" IsToggled="{Binding DarkMode}" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LanguageCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" HeightRequest="40">
                    <Label Text="Langue" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Français" Style="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="Se déconnecter" Style="{StaticResource Outline}" Command="{Binding LogoutCommand}" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
