<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="TachePro.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:views="clr-namespace:TachePro.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Text2Light}">

    <!-- Écran 1 : Connexion (hors barre de navigation) -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Barre de navigation principale : 4 onglets -->
    <TabBar>
        <ShellContent Title="Accueil" Icon="ic_home.png" Route="dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Tâches" Icon="ic_tasks.png" Route="tasks" ContentTemplate="{DataTemplate views:TasksPage}" />
        <ShellContent Title="Équipe" Icon="ic_team.png" Route="team" ContentTemplate="{DataTemplate views:TeamPage}" />
        <ShellContent Title="Profil" Icon="ic_profile.png" Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>
